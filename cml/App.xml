<Component id="App">
  <Signature purpose="Root shell of a book site"
    description="The whole book-site application in one component"
    group="Books" />
  <LocalStorage Ref="localStorage" />
  <StoredData Ref="treeState" />
  <BrowserService Ref="browser" />
  <OnMount If="{@browser.isMobile}" action="-> @localStorage.collapsed = true" />
  <DropdownsPlugin />
  <PortalsPlugin />
  <HotReloadService If="{R.hotPort}" port="{R.hotPort}" />

  <div class="flex flex-col h-screen" >
    <DocsService Ref="docs"
      Props="{R.book}"
      doc="{@browser.path || 'index.md'}" />

    <header
      class="flex items-center px-2 border-b border-base-300 transition-[height] duration-200
      {scrolled ? 'h-10' : 'h-14'}">
      <Bar>
        <div class="md:hidden">
          <MenuButton
            opened="{!@localStorage.collapsed}"
            click="-> @localStorage.collapsed = !@localStorage.collapsed" />
        </div>
        <div class="hidden md:flex">
          <IBtn
            icon="{@localStorage.collapsed ? 'panel-left-open' : 'panel-left-close'}"
            size="sm"
            click="-> @localStorage.collapsed = !@localStorage.collapsed" />
        </div>
        <a href="/">
          <Bar
            class="text-xs font-semibold text-base-content/40 uppercase tracking-wider px-1">
            <img class="w-8 h-8" If="{R.app.logo}" src="{R.app.logo}" />
            <!-- <span>{R.app.name|capitalize}</span> -->
          </Bar>
        </a>
      </Bar>
      <div class="flex h-4 w-4
      {@docs.loading?'loading loading-spinner loading-xs text-base-content/50':''}">
      </div>
      <div id="docHeader" class="flex flex-row flex-1 items-center h-full overflow-hidden"></div>
      <Controls/>
    </header>

    <div class="relative flex flex-row flex-1 min-h-0">
      <div If="{!@localStorage.collapsed}"
        class="absolute inset-0 z-10 bg-black/40 md:hidden"
        click="-> @localStorage.collapsed = true"></div>
      <aside
        class="top-0 left-0 z-20 flex flex-col bg-base-200 border-base-300 md:transition-all md:duration-200 overflow-hidden
      {@localStorage.collapsed 
          ? 'relative w-0 h-auto border-b md:h-full md:border-b-0 md:border-r' 
          : 'absolute md:relative w-64 min-w-64 h-full border-r'}">
        <div class="flex-1 overflow-y-auto py-2 px-1">
          <DocsTree 
            If="{!@localStorage.collapsed}" />
        </div>
        <Attribution/>
      </aside>

      <main class="flex-1 overflow-y-auto min-h-0 bg-base-100" scroll="-> scrolled = event.value > 100">
        <div id="top"></div>
        <Skeleton If="{@docs.loading}" />

        <ErrorMessage
          If="@docs.error"
          error="@docs.error"
          class="m-4 truncate"
          close2="-> @docs.error=false" />

        <Fragment
          If="{!@docs.loading}">
          <View class="relative p-6 max-w-4xl mx-auto" If="@docs.doc">
            <Block Nodes="{@docs.nodes}" />
          </View>
        </Fragment>
      </main>

      <FAB icon="arrow-up" title="Scroll to top"
        class="{scrolled ? '' : 'opacity-0 translate-y-4 pointer-events-none'}"
        action="-> @browser.scrollIntoView('top')" />
    </div>
  </div>
</Component>
