<Component id="MDDocument.Book">
  <Signature purpose="Top level Document"
    description="Top level Document wrapper"
    group="Books">
    <Prop id="icon" type="string" description="Optional icon shown before the heading of a level 2 or 3 section" />
    <Slot name="title" description="Inline content of the heading" />
  </Signature>
  <div class="mb-3 overflow-hidden">
    <div portal="docHeader"
      class="flex flex-1  items-center gap-3 px-2 py-3">
      <span
        class="text-xl font-semibold flex-1 truncate">
        {name || title || R.app.name}
      </span>
      <IBtn icon="chevrons-down" size="sm" title="Expand all"
        click="-> @mdService.expandAll()" disabled="{@mdService.expandedAll}" />
      <IBtn icon="chevrons-up" size="sm" title="Collapse all"
        click="-> @mdService.collapseAll()" />
    </div>

    <div class="py-4">
      <Slot />
    </div>
  </div>
</Component>
