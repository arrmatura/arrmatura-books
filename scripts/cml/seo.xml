<Component id="SEO">
  <!-- Primary Meta Tags -->
  <title>{R.app.name}</title>
  <meta name="title" content="{R.app.name}" />
  <meta name="description" content="{R.app.description}" />
  <meta name="keywords" content="{R.app.keywords | join}" />
  <meta name="robots" content="index, follow" />
  <meta name="language" content="English" />
  <meta name="author" content="{R.app.author}" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content="{R.app.name}" />
  <meta property="og:description" content="{R.app.description}" />
  <meta property="og:image" content="{R.app.logo}" />
  <meta property="og:site_name" content="{R.app.name}" />

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:title" content="{R.app.name}" />
  <meta property="twitter:description" content="{R.app.description}" />
  <meta property="twitter:image" content="{R.app.logo}" />

  <!-- Additional SEO Meta Tags -->
  <meta name="theme-color" content="{R.theme.color}" />
  <meta name="format-detection" content="telephone=no" />
</Component>
