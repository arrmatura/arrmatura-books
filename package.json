{
  "name": "arrmatura-books",
  "version": "1.1.7",
  "description": "Arrmatura books-site kit",
  "author": "arrmatura",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts",
      "require": "./dist/index.cjs"
    }
  },
  "esbuild": {
    "entryPoints": {
      "index": "index.ts"
    },
    "outdir": "dist",
    "format": "esm",
    "outExtension": {
      ".js": ".min.js"
    },
    "target": "es2021"
  },
  "scripts": {
    "build": "npx --yes npm-run-all --parallel build:*",
    "build:ts": "bun ./scripts/build.ts",
    "build:codegen": "bun ./scripts/index-module.ts",
    "gates": "npx --yes npm-run-all --parallel typecheck lint",
    "lint": "biome check .",
    "typecheck": "tsc",
    "release": "./scripts/release.sh",
    "prepublish": "npm run build && npm run gates",
    "npm:publish": "npm publish --no-git-checks",
    "link": "./scripts/link-modules.sh arrmatura arrmatura-markdown arrmatura-web ultimus"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2"
  },
  "peerDependencies": {
    "arrmatura-markdown": "^1.0.0",
    "arrmatura-web": "^9.1.1",
    "ultimus": "^2.3.0"
  }
}
