{
  "name": "arrmatura-books",
  "version": "1.1.2",
  "description": "Arrmatura books-site kit",
  "author": "arrmatura",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts",
      "require": "./dist/index.cjs"
    }
  },
  "esbuild": {
    "entryPoints": {
      "index": "index.ts"
    },
    "outdir": "dist",
    "format": "esm",
    "outExtension": {
      ".js": ".min.js"
    },
    "target": "es2021"
  },
  "scripts": {
    "prebuild": "npm run codegen",
    "build": "npx --yes npm-run-all --parallel build:*",
    "build:ts": "bun ./scripts/build.ts",
    "build:css": "npx --yes @tailwindcss/cli -i index.css -o \"dist/index.css\"",
    "codegen": "bun ./scripts/index-module.ts",
    "postcodegen": "biome format --write registry.ts",
    "gates": "npx --yes npm-run-all --parallel typecheck lint",
    "lint": "biome check .",
    "typecheck": "tsc",
    "release": "./scripts/release.sh",
    "prepublish": "npm run build && npm run gates",
    "npm:publish": "npm publish --no-git-checks"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "daisyui": "^5.7.47",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "arrmatura-markdown": "file:../arrmatura-markdown",
    "arrmatura-web": "file:../arrmatura-web",
    "ultimus": "file:../ultimus"
  }
}
